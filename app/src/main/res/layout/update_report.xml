<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/isiReportSebelum"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/loremipsum"
        android:paddingHorizontal="30dp"
        android:paddingTop="10dp"/>

    <TextView
        android:id="@+id/loremipsum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lorem Ipsum's Report"
        android:textSize="24dp"
        android:layout_marginLeft="10dp"
        app:layout_constraintLeft_toLeftOf="parent"

        android:textColor="@color/redReport"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="48dp"/>


    <EditText
        android:id="@+id/reportColumn"
        android:layout_width="373dp"
        android:layout_height="48dp"
        android:layout_marginTop="340dp"
        android:background="@drawable/round_edge"
        android:fontFamily="@font/lexendgigalight"
        android:hint="Wildfire"
        android:paddingHorizontal="10dp"
        android:textColor="@color/white"
        android:textColorHint="@color/hint_color"
        android:textSize="11sp"
        app:layout_constraintHorizontal_bias="0.421"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="4dp"
        android:text="Update Your Report"
        android:textColor="@color/black"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/reportColumn"
        app:layout_constraintLeft_toLeftOf="parent" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="327dp"
        android:layout_height="60dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/update_report_button"
        android:paddingHorizontal="12dp"
        android:paddingVertical="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginBottom="40dp"
        android:text="Update A Report"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.472"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />







</androidx.constraintlayout.widget.ConstraintLayout>