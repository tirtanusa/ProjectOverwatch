<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textColor="@color/black"
        android:layout_marginLeft="158dp"
        android:layout_marginTop="19.5dp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/redReport"
        android:text="Log Out"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="19.5dp"/>

    <ImageView
        android:id="@+id/profile"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_marginLeft="155.5dp"
        android:layout_marginTop="64.5dp"
        android:src="@drawable/circleiconsetting"
        />

    <TextView
        android:id="@+id/nama"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:layout_below="@id/profile"
        android:text="Overwatch"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textSize="16dp"
        android:layout_marginEnd="20dp"
        />


    <TextView
        android:id="@+id/tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:layout_below="@+id/nama"
        android:textAlignment="center"
        android:layout_alignParentEnd="true"
        android:layout_alignParentStart="true"
        android:text="\@overwatch"
        android:textSize="16dp"
        android:layout_marginEnd="20dp"
        />

    <TextView
        android:id="@+id/edit"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="Edit Account"
        android:textColor="@color/black"
        android:layout_below="@+id/tag"
        android:layout_marginLeft="35dp"
        android:textSize="16sp"
        />


    <TextView
        android:id="@+id/privacy"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Privacy And Security"
        android:textColor="@color/black"
        android:layout_below="@+id/edit"
        android:layout_marginLeft="35dp"
        android:gravity="center"
        android:textSize="16sp"
        />

    <TextView
    android:id="@+id/notifreport"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Allow Report Notification "
    android:textColor="@color/black"
    android:layout_below="@+id/privacy"
    android:layout_marginLeft="35dp"
    android:layout_marginTop="15dp"
    android:textSize="16sp"
    />



</RelativeLayout>