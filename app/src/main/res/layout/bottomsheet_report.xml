<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:layout_marginTop="400dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/round_edge_3_background" />

        <TextView
            android:id="@+id/newsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="News"
            android:layout_marginLeft="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="435dp"
            />

        <EditText
            android:id="@+id/inputArea"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:width="327dp"
            android:height="94dp"
            android:background="@drawable/round_edge"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/newsLabel" />
        <ImageView
            android:id="@+id/reportButton"
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/round_edge_2"
            app:layout_constraintStart_toStartOf="parent"
            android:text="Login"
            app:layout_constraintTop_toBottomOf="@+id/inputArea" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/reportButton"
            android:textColor="@color/login_button"
            android:textSize="16dp"
            android:layout_marginTop="12.5dp"
            android:text="Upload Your Report"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>