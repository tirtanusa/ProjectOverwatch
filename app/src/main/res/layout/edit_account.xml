<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:alpha="0.98">

    <TextView
        android:id="@+id/welcome_message"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:gravity="center"
        android:text="Edit Account"
        android:textSize="18dp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginLeft="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="MissingConstraints" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Name"
        android:textStyle="bold"
        android:layout_marginLeft="24dp"
        app:layout_constraintBottom_toTopOf="@id/fullname"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/fullname"
        android:layout_width="357dp"
        android:layout_height="56dp"
        android:layout_marginLeft="24sp"
        android:layout_marginTop="62sp"
        android:width="327sp"
        android:height="64dp"
        android:background="@drawable/round_edge"
        android:paddingLeft="24dp"
        android:ems="10"
        android:hint="Name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/welcome_message" />
    <TextView
        android:id="@+id/password_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password"
        android:textStyle="bold"
        android:layout_marginLeft="24dp"
        app:layout_constraintTop_toBottomOf="@id/fullname"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="8dp"/>
    <EditText
        android:id="@+id/password_field"
        android:layout_width="357dp"
        android:layout_height="56dp"
        android:layout_marginLeft="24sp"
        android:layout_marginTop="8dp"
        android:inputType="textPassword"
        android:width="327sp"
        android:height="64dp"
        android:background="@drawable/round_edge"
        android:paddingLeft="24dp"
        android:ems="10"
        android:hint="Create a Password "
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/password_label" />
    <EditText
        android:id="@+id/confirm_password_field"
        android:layout_width="357dp"
        android:layout_height="56dp"
        android:layout_marginLeft="24sp"
        android:layout_marginTop="16dp"
        android:inputType="textPassword"
        android:width="327sp"
        android:height="64dp"
        android:background="@drawable/round_edge"
        android:paddingLeft="24dp"
        android:ems="10"
        android:hint="Create New Password "
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/password_field" />

    <ImageButton
        android:id="@+id/save_label"
        android:layout_width="130dp"
        android:layout_height="53dp"
        android:background="@drawable/save_button"
        android:text="Save"
        android:textColor="@color/white"
        android:textSize="20dp"
        android:layout_marginTop="58dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="53dp"
        app:layout_constraintTop_toBottomOf="@id/confirm_password_field" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save"
        android:textColor="@color/white"
        android:textSize="20dp"
        app:layout_constraintTop_toTopOf="@id/save_label"
        app:layout_constraintBottom_toBottomOf="@id/save_label"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="94dp"/>

    <ImageButton
        android:id="@+id/cancel_button"
        android:layout_width="130dp"
        android:layout_height="53dp"
        android:background="@drawable/cancel_button"
        android:textColor="@color/login_button"
        android:layout_marginTop="58dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="53dp"
        app:layout_constraintTop_toBottomOf="@id/confirm_password_field" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:textColor="@color/login_button"
        android:textSize="20dp"
        app:layout_constraintTop_toTopOf="@id/save_label"
        app:layout_constraintBottom_toBottomOf="@id/save_label"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="83dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>