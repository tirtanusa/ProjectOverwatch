<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <ImageView
        android:id="@+id/background"
        android:layout_marginTop="400dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/round_edge_3_background" />
    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="News"
        android:textSize="12sp"
        android:layout_marginLeft="19dp"
        android:layout_marginTop="35dp"
        app:layout_constraintBottom_toTopOf="@id/reportColumn"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/background"/>

    <EditText
        android:layout_marginTop="8dp"
        android:id="@+id/reportColumn"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:width="327dp"
        android:height="94dp"
        android:background="@drawable/round_edge"
        app:layout_constraintTop_toBottomOf="@+id/label"/>


    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/round_edge_2"
        app:layout_constraintTop_toBottomOf="@id/reportColumn"
        android:layout_marginTop="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:text="Post A Report"
        android:textColor="@color/login_button"
        android:layout_marginTop="12.5dp"
        app:layout_constraintTop_toTopOf="@id/imageView4"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>